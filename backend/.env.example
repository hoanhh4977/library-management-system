# Supabase project settings (copy real values from repo-root .env)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Direct Postgres connection to the same Supabase project (Project Settings -> Database)
# postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:5173
